APP_NAME="Climbing Judge AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Europe/Budapest
APP_LOCALE=hu

DB_DATABASE=climbing_judge
DB_USERNAME=climbing
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_FORWARD_PORT=3307

SESSION_DRIVER=database
CACHE_STORE=file
FILESYSTEM_DISK=public

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

AI_SERVICE_URL=http://ai-service:8000/analyze
AI_STATUS_URL=http://ai-service:8000/status
AI_SERVICE_PORT=8000
AI_SERVICE_TIMEOUT=330

# Valaszthato: mock, openai, ollama. Nincs automatikus fallback.
AI_PROVIDER=mock

# OpenAI beallitasok. Az OPENAI_MODEL elsobbseget elvez a regi AI_MODEL-lel szemben.
AI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama belso Docker-cime, vision modellje es masodpercben megadott idokorlatja.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_TIMEOUT=300
# Fejlesztesi/hibakeresesi host port.
OLLAMA_PORT=11434

UID=1000
GID=1000
